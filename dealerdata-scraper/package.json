{
  "name": "dealerdata-scraper",
  "version": "1.0.0",
  "description": "High-performance automotive dealership crawler, sitemap discoverer, and clean listing extractor for DealerData SaaS",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "scrape": "ts-node src/cli.ts",
    "crawl": "ts-node src/cli.ts",
    "crawl:sitemap": "ts-node src/cli.ts --no-api",
    "crawl:auto": "ts-node src/cli.ts",
    "fix:inventory": "ts-node src/scripts/fixInventory.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts"
  },
  "keywords": [
    "crawler",
    "scraper",
    "automotive",
    "dealership",
    "dealerdata",
    "sitemap",
    "vin"
  ],
  "author": "DealerData Engineering",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "crawlee": "^3.12.2",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^4.5.1",
    "https-proxy-agent": "^7.0.6",
    "mysql2": "^3.12.0",
    "playwright": "^1.64.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
